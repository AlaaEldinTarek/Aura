<?xml version="1.0" encoding="utf-8"?>
<!-- Post-prayer check, COMPACT collapsed view, dark theme, English (left-to-right) (docs/designs/fix-post-check-remind-later.md,
     R1d). Fits the ~64 dp collapsed slot: row 1 = question + small Remind Later pill, row 2 = the three
     tinted buttons. No icon, no subtitle. Same ids as the expanded layout. Explicit left/right, root forced LTR. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_dark"
    android:layoutDirection="ltr"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/btn_remind_later"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:maxLines="1"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:background="@drawable/bg_vibration_button_dark"
        android:clickable="true"
        android:focusable="true"
        android:text="Remind Later"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#F5B301" />

    <TextView
        android:id="@+id/post_check_title"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_toLeftOf="@id/btn_remind_later"
        android:layout_marginRight="8dp"
        android:gravity="center_vertical|left"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Did you pray Zuhr?"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <LinearLayout
        android:id="@+id/post_check_buttons"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_below="@id/btn_remind_later"
        android:layout_marginTop="3dp"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/btn_done"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:gravity="center"
            android:maxLines="1"
            android:background="@drawable/bg_post_check_done_dark"
            android:clickable="true"
            android:focusable="true"
            android:text="Done"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#4CAF50" />

        <TextView
            android:id="@+id/btn_late"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginRight="5dp"
            android:gravity="center"
            android:maxLines="1"
            android:background="@drawable/bg_post_check_late_dark"
            android:clickable="true"
            android:focusable="true"
            android:text="Late"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FF9800" />

        <TextView
            android:id="@+id/btn_missed"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:background="@drawable/bg_post_check_missed_dark"
            android:clickable="true"
            android:focusable="true"
            android:text="Missed"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#F44336" />
    </LinearLayout>
</RelativeLayout>
