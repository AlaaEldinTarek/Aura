<?xml version="1.0" encoding="utf-8"?>
<!-- Post-prayer check, collapsed view (docs/designs/fix-post-check-remind-later.md, option B, phase R1b):
     used with DecoratedCustomViewStyle. Remind Later sits in the end corner (right in English, left in
     Arabic); the _rtl file sets layoutDirection from the APP language, like the other _rtl layouts. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <TextView
        android:id="@+id/btn_remind_later"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        android:text="Remind Later"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/post_check_action" />

    <LinearLayout
        android:id="@+id/post_check_texts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/btn_remind_later"
        android:orientation="vertical">

        <TextView
            android:id="@+id/post_check_title"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Did you pray Zuhr?"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/post_check_body"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Log your prayer now"
            android:textSize="14sp" />
    </LinearLayout>
</RelativeLayout>
