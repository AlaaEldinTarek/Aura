<?xml version="1.0" encoding="utf-8"?>
<!-- Task reminder card, light RTL (Arabic, mirrored) (docs/designs/fix-themed-notifications.md, T2).
     Plain horizontal LinearLayout like notification_actions*.xml. Root forced LTR with the children written in mirrored order: from the right icon, text, button on the left.
     Used for the collapsed and the expanded view. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_notification"
    android:layoutDirection="ltr"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/btn_task_remind_later"
        android:layout_width="84dp"
        android:layout_height="28dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:background="@drawable/bg_post_check_remind_light"
        android:clickable="true"
        android:focusable="true"
        android:text="Remind Later"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#B5821B" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/task_reminder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Task reminder"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#DE000000"
            android:textDirection="rtl" />

        <TextView
            android:id="@+id/task_reminder_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Your task is due"
            android:textSize="12sp"
            android:textColor="#99000000"
            android:textDirection="rtl" />

    </LinearLayout>

    <ImageView
        android:id="@+id/task_reminder_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="centerCrop"
        android:contentDescription="Aura" />

</LinearLayout>
